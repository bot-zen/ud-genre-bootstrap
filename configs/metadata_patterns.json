{
  "_comment": "Pattern-based genre extraction for treebank-specific metadata formats",
  "_format": "Treebank code -> list of pattern objects",
  "_pattern_fields": {
    "pattern": "Required: regex to match against sentence comments",
    "genre": "Optional: static genre or $1/$2 for capture groups",
    "genre_mapping": "Optional: dict mapping captured values to genres"
  },
  "cs_cac": [
    {
      "_description": "Czech CAC: extract first and last letter from doc ID (e.g., a01w -> aw)",
      "_example": "# sent_id = a01w-... -> extracts 'aw' -> maps to 'news'",
      "pattern": "# sent_id = ([a-z])\\d+([a-z])-.*",
      "genre": "$1$2"
    }
  ],
  "en_ewt": [
    {
      "_description": "Extract genre from document ID prefix",
      "pattern": "# sent_id = ([a-z]+)-",
      "genre": "$1",
      "genre_mapping": {
        "weblog": "blog",
        "email": "email",
        "reviews": "reviews",
        "newsgroup": "social",
        "answers": "social"
      }
    }
  ],

  "en_gum": [
    {
      "_description": "GUM corpus uses genre in document ID",
      "pattern": "# sent_id = GUM_([a-z]+)_",
      "genre": "$1",
      "genre_mapping": {
        "academic": "academic",
        "blog": "blog",
        "fiction": "fiction",
        "government": "government",
        "news": "news",
        "nonfiction": "nonfiction",
        "social": "social",
        "spoken": "spoken",
        "web": "web",
        "wiki": "wiki",

        "bio": "wiki",
        "court": "wiki",
        "essay": "wiki",
        "interview": "wiki",
        "letter": "wiki",
        "podcast": "wiki",
        "speech": "wiki",
        "textbook": "wiki",
        "vlog": "wiki",
        "voyage": "wiki",
        "whow": "wiki"
      }
    }
  ],

  "fi_tdt": [
    {
      "_description": "Finnish TDT encodes genre in doc_name",
      "pattern": "# doc_name = (blog|news|wiki)_",
      "genre": "$1"
    }
  ],
  "cs_pdt": [
    {
      "_description": "Czech PDT uses source field with mapping",
      "pattern": "# source = (.+)",
      "genre_mapping": {
        "news": "news",
        "magazine": "news",
        "business": "news",
        "culture": "news",
        "sport": "news",
        "blog": "blog",
        "forum": "social"
      }
    }
  ],
  "fr_gsd": [
    {
      "_description": "Extract from file path in sent_id",
      "pattern": "# sent_id = .+/(blog|news|wiki|fiction)/",
      "genre": "$1"
    }
  ],

  "it_isdt": [
    {
      "_description": "Multiple patterns tried in order",
      "pattern": "# newdoc id = .+-(news|blog|legal)",
      "genre": "$1"
    },
    {
      "_description": "Fallback to explicit genre field",
      "pattern": "# genre = (.+)",
      "genre": "$1"
    }
  ],

  "ja_gsd": [
    {
      "_description": "Japanese GSD with source type mapping",
      "pattern": "# source_type = (.+)",
      "genre_mapping": {
        "wikipedia": "wiki",
        "blog": "blog",
        "news": "news",
        "textbook": "academic"
      }
    }
  ]
}
