{
  "_comment": "Pattern-based genre extraction for treebank-specific metadata formats",
  "_format": "Treebank code -> list of pattern objects",
  "_pattern_fields": {
    "pattern": "Required: regex to match against sentence comments",
    "genre": "Optional: static genre or $1/$2 for capture groups",
    "genre_mapping": "Optional: dict mapping captured values to genres"
  },

  "be_hse": [
    {
      "genre_mapping": {
        "fiction": "fiction",
        "legal": "legal",
        "news": "news",
        "news-poll-question": "news",
        "nonfiction": "nonfiction",
        "poetry": "poetry",
        "social-media": "social",
        "social-media-poll-question": "social",
        "social-media-poll-answer": "social",
        "wiki": "wiki"
      }
    }
  ],

  "cs_cac": [
    {
      "_description": "Czech CAC: uses combined letters, extract first and last letter (e.g., a01w -> aw)",
      "_example": "# sent_id = a01w-... -> extracts 'aw' -> maps to 'news'",
      "pattern": "# sent_id = ([a-z])\\d+([a-z])-.*",
      "genre": "$1$2",
      "genre_mapping": {
          "aw": "legal",
          "nw": "news",
          "sw": "nonfiction"
      }
    }
  ],

  "en_ewt": [
    {
      "pattern": "# sent_id = ([a-z]+)-",
      "genre": "$1",
      "genre_mapping": {
        "weblog": "blog",
        "email": "email",
        "reviews": "reviews",
        "newsgroup": "social",
        "answers": "social"
      }
    }
  ],

  "en_gum": [
    {
      "pattern": "# sent_id = GUM_([a-z]+)_",
      "genre": "$1",
      "genre_mapping": {
        "court": "spoken",
        "speech": "spoken",
        "textbook": "nonfiction",
        "_comment_wiki": "wikivoyage: worldwide travel guide that you can edit. NOTE: much more like wiki than guide",
        "voyage": "wiki",
        "_comment_whow": "wikiHow: how-to site on the internet",
        "whow": "nonfiction",
        "_comment_bio": "biographies, very similar to the beginning of a wikipedia page",
        "bio": "wiki",
        "essay": "nonfiction",
        "letter": "nonfiction",
        "podcast": "spoken",
        "vlog": "spoken"
      }
    }
  ],

  "pl_lfg": [
    { 
      "genre_mapping": {
         "news": "news",
         "nonfiction": "nonfiction",
         "social": "social",
         "fiction": "fiction",
         "spoken (conversational)": "spoken",
         "spoken (media)": "spoken",
         "spoken (prepared)": "spoken",
         "blog": "blog",
         "academic": "nonfiction",
         "legal": "legal"
      }
    }
  ],

  "ru_taiga": [
    {
      "genre_mapping": {
        "social": "social",
        "poetry": "poetry",
        "news": "news",
        "fiction": "fiction",
        "wiki": "wiki",
        "QA-health-question": "social",
        "QA-health-answer-author": "social",
        "QA-health-answer": "social",
        "QA-health-question-title": "social",
        "QA-travel-question": "social",
        "QA-travel-answer": "social",
        "review": "reviews",
        "nonfiction": "nonfiction",
        "QA-countries-question": "social",
        "QA-lifestyle-question": "social",
        "QA-relax-question": "social",
        "QA-animals_plants-question": "social",
        "QA-family-question": "social",
        "QA-science-question": "social",
        "QA-love-question": "social",
        "QA-culture-question": "social",
        "QA-society-question": "social",
        "nonfiction-academic-encycl": "academic",
        "fiction-kids": "fiction"
      }
    }
  ],

  "cs_pdtc": [
    {
      "_description": "Czech-PDTC: based on the PDT – Consolidated",
      "_link": "https://github.com/UniversalDependencies/UD_Czech-PDTC/blob/master/README.md",
      "pattern": "# sent_id = ([a-z]+)[_0-9]",
      "genre": "$1",
      "genre_mapping": {
        "cmpr": "news",
        "wsj": "news", 
        "faust": "learner-essays",
        "pdtsc": "spoken",
        "ln": "news",
        "mf": "news",
        "vesm": "academic",
        "lnd": "news",
        "magazine": "news",
        "business": "news",
        "culture": "news",
        "sport": "news",
        "blog": "blog",
        "forum": "social"
      }
    }
  ],

  "cs_cac": [
    {
      "pattern": "# sent_id = ([a-z])[0-9]+w-.+",
      "genre": "$1",
      "genre_mapping": {
        "a": "government",
        "s": "academic",
        "n": "news"
      }
    }
  ],

  "de_lit": [
    {
      "genre_mapping": {
        "fragments": "nonfiction"
      }
    }
  ],

  "gl_pud": [
    {
      "_description": "Galician-PUD",
      "pattern": "# sent_id = ([a-z]+)[0-9]",
      "genre": "$1"
    }
  ],

  "is_pud": [
    {
      "_description": "Icelandic-PUD",
      "pattern": "# sent_id = ([a-z]+)[0-9]",
      "genre": "$1"
    }
  ],

  "ja_pudluw": [
    {
      "_description": "Japanese-PUDLUW (Long Unit Word)",
      "pattern": "# sent_id = ([a-z]+)[0-9]",
      "genre": "$1"
    }
  ]
}
