{
  "_comment": "Pattern-based genre extraction for treebank-specific metadata formats",
  "_format": "Treebank code -> list of pattern objects",
  "_pattern_fields": {
    "pattern": "Required: regex to match against sentence comments",
    "genre": "Optional: static genre or $1/$2 for capture groups",
    "genre_mapping": "Optional: dict mapping captured values to genres"
  },

  "be_hse": [
    {
      "_description": "Belarusian-HSE",
      "genre_mapping": {
        "news-poll-question": "news",
        "news-poll-answer": "news",
        "social-media": "social",
        "social-media-poll-question": "social",
        "social-media-poll-answer": "social"
      }
    }
  ],

  "cs_cac": [
    {
      "_description": "Czech CAC: uses combined letters, extract first and last letter (e.g., a01w -> aw)",
      "_example": "# sent_id = a01w-... -> s20w identifies the source document, 'w':'written', '20':document id and 's':scientific, 'a':administrative, 'n':newspaper",
      "pattern": "# sent_id = ([a-z])[0-9]+([a-z])-",
      "genre": "$1$2",
      "genre_mapping": {
          "aw": "legal",
          "nw": "news",
          "sw": "nonfiction"
      }
    }
  ],

  "cs_cltt": [
    {
      "_description": "CLTT consists of two legal documents",
      "genre": "legal"
    }
  ],

  "cs_fictree": [
    {
      "_description": "The eight texts in the treebank include six fiction titles, a children’s fiction book, and a book of memoirs",
      "genre": "fiction"
    }
  ],

  "cs_pdtc": [
    {
      "_description": "Czech-PDTC: based on the PDT – Consolidated",
      "_link": "https://github.com/UniversalDependencies/UD_Czech-PDTC/blob/master/README.md",
      "pattern": "# sent_id = ([a-z]+)[_0-9]",
      "genre": "$1",
      "genre_mapping": {
        "cmpr": "news",
        "wsj": "news", 
        "faust": "learner-essays",
        "pdtsc": "spoken",
        "ln": "news",
        "mf": "news",
        "vesm": "academic",
        "lnd": "news",
        "magazine": "news",
        "business": "news",
        "culture": "news",
        "sport": "news",
        "blog": "blog",
        "forum": "social"
      }
    }
  ],

  "de_gsd": [
    {
      "pattern": "# sent_id = train-(s[1-9]|s[1-9][0-9]|s[1-9][0-9][0-9]|s1[0-4][0-9][0-9])$",
      "genre": "reviews"
    },
    {
      "pattern": "# sent_id = train-(s1[5-9][0-9][0-9]|s2[0-1][0-9][0-9])$",
      "genre": "news"
    },
    {
      "pattern": "# sent_id = train-(s2[2-9][0-9][0-9]|s[3-9][0-9][0-9][0-9]|s1[0-4][0-9][0-9][0-9])$",
      "genre": "web"
    },
    {
      "pattern": "# sent_id = dev-(s[1-9]|s[1-9][0-9]|s[1-4][0-9][0-9])$",
      "genre": "reviews"
    },
    {
      "pattern": "# sent_id = dev-(s[5-7][0-9][0-9])$",
      "genre": "news"
    },
    {
      "pattern": "# sent_id = test-(s[1-9]|s[1-9][0-9]|s[1-2][0-9][0-9])$",
      "genre": "reviews"
    },
    {
      "pattern": "# sent_id = test-(s[3-9][0-9][0-9])$",
      "genre": "news"
    }
  ],

  "de_hdt": [
    {
      "_description": "The sentences were all sourced from the German news site heise.de",
      "genre": "news"
    }
  ],

  "de_lit": [
    {
      "genre_mapping": {
        "fragments": "nonfiction"
      }
    }
  ],

  "egy_ujaen": [
    {
      "_comment": "Treebank genre: bible fiction nonfiction government; Old Egyptian multiword expressions and sentences from the Pyramid Texts",
      "genre": "poetry",
      "genre_mapping": {
        "religious": "poetry"
      }
    }
  ],

  "egy_pc": [
    {
      "_comment": "Treebank genre: bible fiction nonfiction government; Old Egyptian multiword expressions and sentences from the Pyramid Texts",
      "genre": "poetry",
      "genre_mapping": {
        "religious": "poetry"
      }
    }
  ],

  "en_ewt": [
    {
      "pattern": "# sent_id = ([a-z]+)-",
      "genre": "$1",
      "genre_mapping": {
        "weblog": "blog",
        "newsgroup": "social",
        "answers": "social"
      }
    }
  ],

  "en_gum": [
    {
      "pattern": "# sent_id = GUM_([a-z]+)_",
      "genre": "$1",
      "genre_mapping": {
        "court": "spoken",
        "speech": "spoken",
        "textbook": "nonfiction",
        "_comment_wiki": "wikivoyage: worldwide travel guide that you can edit. NOTE: much more like wiki than guide",
        "voyage": "wiki",
        "_comment_whow": "wikiHow: how-to site on the internet",
        "whow": "nonfiction",
        "_comment_bio": "biographies, very similar to the beginning of a wikipedia page",
        "bio": "wiki",
        "essay": "nonfiction",
        "letter": "nonfiction",
        "podcast": "spoken",
        "vlog": "spoken"
      }
    }
  ],
          
  "fr_poitevindivital": [
