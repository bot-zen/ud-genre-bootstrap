      "_description": "genre = tale; form = prose",
      "pattern": "sent_id = (contesmarais|contemarais|coulun|leprincot|daudet_lundi_tr_pos|daudet_lettres_tr_po|LA.conllu|PierreLoup_Pos|Parabole|ventsnordét|gascougne)",
      "genre": "fiction"
    },
    {
      "_description": "genre = press; form = prose",
      "pattern": "sent_id = feltin",
      "genre": "news"
    },
    {
      "_description": "genre = poetry; form = prose",
      "pattern": "sent_id = fineamour",
      "genre": "poetry"
    },
    {
      "genre_mapping": {
        "press": "news",
        "tale": "fiction"
      }
    }
  ],

