{
  "_comment": "Genre extraction patterns for PUD (Parallel Universal Dependencies) treebanks",
  "_description": "PUD treebanks encode genre in sent_id: 'n' = news, 'w' = wiki",

  "ar_pud": [ { "pattern": "# sent_id = ([nw])", "genre": "$1" } ],
  "cs_pud": [ { "pattern": "# sent_id = ([nw])", "genre": "$1" } ],
  "de_pud": [ { "pattern": "# sent_id = ([nw])", "genre": "$1" } ],
  "en_pud": [ { "pattern": "# sent_id = ([nw])", "genre": "$1" } ],
